<?xml version="1.0" encoding="utf-8"?>
<!--
  anoterm は SSH（TCP 生 socket）しか使わないが、将来 HTTP 呼び出しが混入した時の
  防波堤として cleartext を禁止し、system CA のみを信頼する設定を明示する。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!--
      SSH の中を通した先だけ平文を許す。転送の出口は必ず自分の 127.0.0.1 で、そこから先は
      SSH の暗号の中を通る。平文が端末の外に出るわけではない。`localhost` は入れていない。
      入り口を 1 つに絞っておけば、意図しない宛先が紛れても素通りしない。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
